# Copy to .env and adjust. Never commit .env.

# Port the app listens on, on the CT's LAN address.
APP_PORT=80

# Timezone for due dates, "this week" (Sun–Sat) and report ranges.
APP_TIMEZONE=America/Denver

# Optional: create the admin account on first start instead of using the /setup page.
# Remove ADMIN_PASSWORD from this file after the first start.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Max size per uploaded attachment, in MB.
MAX_UPLOAD_MB=25

# Name printed as "Prepared by" on PDF reports (defaults to your username).
REPORT_AUTHOR=

# Nightly backups (scripts/backup.sh). Point BACKUP_DIR at your NAS mount.
BACKUP_DIR=/mnt/nas/board-of-bored
BACKUP_KEEP=14

# Only when running behind an HTTPS reverse proxy (Caddy, Nginx Proxy Manager, pfSense HAProxy):
# (X-Forwarded-Proto is already trusted; plain LAN HTTP works without any of these.)
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
